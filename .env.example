# Next.js variables
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ==========================================
# RUNTIME APLIKASI
# ==========================================
# Dua variabel di atas SATU-SATUNYA yang dibaca kode aplikasi, dan satu-
#-satunya yang perlu diisi di Vercel. Keduanya ikut ter-inline ke bundel
# browser saat build, jadi mengubahnya wajib deploy ulang, tidak cukup
# restart.
#
# Anon key memang dirancang publik dan dikirim ke browser; yang melindungi
# data adalah RLS, bukan kerahasiaan key. Yang tidak boleh masuk ke Vercel
# adalah service_role key, dan kode ini memang tidak pernah memakainya:
# operasi tulis lewat API Read memakai JWT user, bukan service_role.

# ==========================================
# SUPABASE CLI (khusus migrasi & verifikasi)
# ==========================================
# Dipakai `supabase link` dan `supabase db push`. BUKAN dipakai runtime
# aplikasi. JANGAN diisi di Vercel: tidak ada kode yang membutuhkannya,
# dan menambahkannya hanya memperbesar permukaan serang.
#
# File .env sudah di-gitignore. Jangan pernah commit nilainya.

# Project ref, sama dengan bagian sebelum titik pada connection string.
# Alternate: `npx supabase link --project-ref <REF>`
SUPABASE_PROJECT_ID=your_project_ref

# Personal Access Token. Buat di
# Supabase -> Account Preferences (avatar kanan atas) -> Access Tokens.
# Alternate: `npx supabase login --token <TOKEN>`
SUPABASE_ACCESS_TOKEN=your_access_token

# Password role postgres, BUKAN password login Supabase dan BUKAN
# password OAuth GitHub. Ambil dari Supabase -> Settings -> Database.
# Kalau lupa, reset di sana: anon key, akun auth, dan file di Storage
# tidak ikut berubah, tapi nilai di .env harus diupdate.
SUPABASE_DB_PASSWORD=your_database_password

# ==========================================
# KONEKSI POSTGRES LANGSUNG (psql / pg_dump)
# ==========================================
# JANGAN tulis URL koneksi lengkap di sini. Password database mengandung
# karakter yang merusak URL kalau mentah: '#' membuat sisanya dibaca
# sebagai fragment sehingga password terpotong, dan koneksi gagal dengan
# pesan yang menyesatkan. '@', '/', '%', dan ':' punya masalah serupa.
#
# scripts/db-url.sh membangun URL dari SUPABASE_DB_PASSWORD di atas,
# meng-URL-encode passwordnya, lalu mengekspor PGURL. Dipakai `pg_dump`
# untuk backup dan `psql` untuk verifikasi skema. Tidak dipakai
# Supabase CLI.
#
# WAJIB session pooler (port 5432), bukan transaction pooler (6543).
# DDL seperti CREATE TABLE, ALTER TABLE, dan CREATE POLICY tidak bisa
# jalan di dalam transaction pooler.
#
# Region proyek. Hapus baris ini untuk memakai default
# aws-1-ap-southeast-1; set eksplisit kalau proyek dipindah region.
# SUPABASE_DB_REGION=aws-1-ap-southeast-1

# ==========================================
# ADMIN PANEL
# ==========================================
# Email yang terdaftar di tabel public.admins. Email ini TIDAK ditulis
# di migration, jadi tidak pernah masuk ke repo publik.
#
# Hanya dipakai satu kali, untuk mengisi tabel admins lewat psql. Setelah
# itu tidak dibaca kode apa pun, jadi juga tidak perlu ada di Vercel.
#
# Cara pakai: isi di .env, lalu jalankan INSERT lewat psql, atau
# lewati saja dan tambahkan manual dari
# Supabase Dashboard -> Table Editor -> public -> admins.
#
# Harus PERSIS sama dengan email login di
# Supabase -> Authentication -> Users (case-sensitive).
ADMIN_EMAIL=
